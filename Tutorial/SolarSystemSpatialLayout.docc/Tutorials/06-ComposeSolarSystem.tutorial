@Tutorial(time: 30) {
    @Intro(title: "태양계 장면 완성하기") {
        원형 궤도선과 깊이를 가진 행성 뷰를 같은 공간에 합성하고, 레이아웃 자체를 기울여 태양계를 완성합니다.

        @Image(source: starfield-texture.jpg, alt: "완성된 태양계를 둘러싸는 별이 빛나는 배경")
    }

    @Section(title: "궤도선 그리기") {
        @ContentAndMedia {
            궤도선은 깊이가 없는 SwiftUI `Circle`입니다. 행성 설정에서 0보다 큰 반지름만 추출해 태양을 제외한 여덟 개의 원을 그립니다.
        }

        @Steps {
            @Step {
                모든 원을 같은 중심에 겹치고 전체 캔버스를 커스텀 레이아웃과 동일한 크기로 고정합니다.

                @Code(name: "OrbitGuideView.swift", file: Step06OrbitGuideView.swift)
            }
        }
    }

    @Section(title: "2D와 3D 뷰를 한 공간에 합성하기") {
        @ContentAndMedia {
            `SpatialContainer`는 깊이가 0인 궤도선과 깊이를 가진 Model3D 행성들을 같은 3차원 좌표 공간에 배치합니다. 커스텀 레이아웃에 `.depthAlignment(.front)`를 적용하면 크기가 다른 행성들이 앞면 기준으로 정렬됩니다.
        }

        @Steps {
            @Step {
                `SpatialContainer` 안에 `OrbitGuideView`와 `SolarSystemSpatialLayout`을 나란히 넣습니다.
            }

            @Step {
                `rotation3DLayout`으로 궤도 평면을 58도 기울입니다. 이 수정자는 회전된 경계를 레이아웃 계산에 반영합니다.
            }

            @Step {
                각 `PlanetModelView`에는 반대 방향의 `rotation3DEffect`를 적용합니다. 이 수정자는 시각적 결과만 회전하므로 행성의 궤도 위치는 바꾸지 않으면서 모델과 이름표를 사용자 쪽으로 돌릴 수 있습니다.

                @Code(name: "SolarSystem.swift", file: Step06SolarSystem.swift)
            }

            @Step {
                앱을 빌드하고 “입장하기”를 선택합니다. 태양과 여덟 행성이 각자의 정적 초기 각도에 놓이고, 원형 궤도선과 별 배경이 함께 보이는지 확인합니다. 공전과 명왕성 탈출은 <doc:Roadmap>에서 다음 구현 단계로 다룹니다.
            }
        }
    }
}
